# Canonical Bodai runtime artifacts (per bodai-canonical-gitignore-runtime-artifacts).
# Apply the same block at every Bodai repo so `.cache/`, `.crackerjack/`,
# coverage reports, and editor backouts never pollute the index.

# --- Tooling caches ----------------------------------------------------
.cache/
.crackerjack/
.complexipy_cache/
.htmlcov/
htmlcov/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Coverage / quality reports ---------------------------------------
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/
.lychee*
.betterleaks.toml

# --- Local config (per repo) -------------------------------------------
local-config.yaml
.env
.env.local
.env.*.local

# --- Backup / editor scratch -------------------------------------------
*.bak
*.backup
*.backup.json
*~
.DS_Store
.idea/
.vscode/
*.swp

# --- Python bytecode ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
