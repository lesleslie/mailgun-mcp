# Canonical Bodai runtime artifacts (per bodai-canonical-gitignore-runtime-artifacts).
# Apply the same block at every Bodai repo so `.cache/`, `.crackerjack/`,
# coverage reports, and editor backouts never pollute the index.

# --- Tooling caches ----------------------------------------------------
.cache/
.crackerjack/
.complexipy_cache/
.oneiric_cache/
.pyscn/
.htmlcov/
htmlcov/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Coverage / quality reports ---------------------------------------
.coverage
.coverage.*
.coverage-ratchet.json
coverage.json
coverage.xml
htmlcov/
.lychee*
.betterleaks.toml

# --- Local config (per repo) -------------------------------------------
local-config.yaml
.env
.env.local
.env.*.local
.envrc

# --- Backup / editor scratch -------------------------------------------
*.bak
*.backup
*.backup.json
*~
.DS_Store
.idea/
.vscode/
*.swp
docs/.backups/

# --- Python bytecode ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# ============================================================================
# Bodai-wide gitignore patterns (added 2026-09-07; cross-repo cleanup sweep)
# ============================================================================
# Editor / pre-edit backups (foo.py.backup, foo.py.backup.json)
*.backup
*.backup.*
*.bak
*.tmpl
# XDG mistake dirs (env var expansion failed; literal names)
~
[{]HOME[}]
[{]XDG_DATA_HOME:-$HOME
# pytest-benchmark autosave cache (sibling of the tracked `benchmarks/` test suite)
.benchmarks/
# Vitest config timestamp cache
vitest.config.js.timestamp-*.mjs
# Playwright output cruft
playwright-junit.xml
playwright-report/
playwright-results.json
test-results/


# >>> bodai-shared-gitignore >>>
# Source of truth: crackerjack/templates/GITIGNORE_BODAI.md
# Enforced by: crackerjack check `gitignore-conformance`
# Fleet list: /Users/les/Projects/mahavishnu/BODAI_REPO_REGISTRY.md
# Do NOT remove the marker line above — `crackerjack gitignore sync` uses it
# to detect already-applied state.

# Editor / pre-edit backups (foo.py.backup, foo.py.backup.json)
*.backup
*.backup.*
*.bak
*.tmpl
# XDG mistake dirs (env var expansion failed; literal names)
# Note: both `{` and `}` are escaped (`{` -> `[{]`, `}` -> `[}]`)
# because gitignore parsers interpret `${...}` as a brace-expansion
# alternate group; escaping only the open brace leaves a stray `}`.
~
[{]HOME[}]
[{]XDG_DATA_HOME:-$HOME[}]
# pytest-benchmark autosave cache (sibling of the tracked `benchmarks/` test suite)
.benchmarks/
# Vitest config timestamp cache
vitest.config.js.timestamp-*.mjs
# Playwright output cruft
playwright-junit.xml
playwright-report/
playwright-results.json
test-results/
# <<< bodai-shared-gitignore <<<
